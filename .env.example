# ---------- Paste your MongoDB Atlas connection string here ----------
# Atlas > Database > Connect > Drivers > copy the string, then replace <password>.
# Add a database name before the "?" (example: /orgportal).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/orgportal?retryWrites=true&w=majority

# ---------- App ----------
PORT=3000
# Change this to any long random string (used to sign login tokens)
JWT_SECRET=change-me-to-a-long-random-string

# ---------- First admin (created automatically on first start) ----------
ADMIN_NAME=Organization Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---------- Uploads (Document Center) ----------
# Largest file an admin can upload, in megabytes.
MAX_UPLOAD_MB=15
